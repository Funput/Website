---
import { FUNPUT_CONSTANTS as links } from '../lib/constants';
import { PLATFORMS } from '../lib/platforms';
import StoreDownloadButton from './StoreDownloadButton.astro';
const stores = [
  {
    id: 'windows',
    name: 'Windows',
    storeName: 'Microsoft Store',
    word: 'xin chào',
    description:
      'Từ tin nhắn đến tài liệu. Cài dễ dàng, gõ quen tay và cập nhật qua Microsoft Store.',
    requirements: 'Windows 10 từ 1809 · Windows 11',
    badge: 'MỚI TRÊN STORE',
  },
  {
    id: 'ios',
    name: 'iPhone & iPad',
    storeName: 'App Store',
    word: 'chào bạn',
    description: 'Một bàn phím, trọn từng dấu. Mang Telex và VNI quen thuộc vào iPhone và iPad.',
    requirements: 'iOS / iPadOS 18.6 trở lên',
    badge: 'SẴN SÀNG TẢI',
  },
  {
    id: 'android',
    name: 'Android',
    storeName: 'Google Play',
    word: 'gõ vui nhé',
    description:
      'Gõ vui trên mọi hành trình. Bàn phím tiếng Việt cho điện thoại và máy tính bảng Android.',
    requirements: 'Android 8.0 trở lên',
    badge: 'SẴN SÀNG TẢI',
  },
] as const;
const accents = [
  { name: 'Ngang', mark: 'a', letter: 'a', word: 'ma' },
  { name: 'Sắc', mark: '´', letter: 'á', word: 'má' },
  { name: 'Huyền', mark: '`', letter: 'à', word: 'mà' },
  { name: 'Hỏi', mark: '̉', letter: 'ả', word: 'mả' },
  { name: 'Ngã', mark: '~', letter: 'ã', word: 'mã' },
  { name: 'Nặng', mark: '.', letter: 'ạ', word: 'mạ' },
];
---

<div class="funput-home">
  <section class="hero wrap" id="home-content" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> FUNPUT · BỘ GÕ TIẾNG VIỆT MÃ NGUỒN MỞ
      </p>
      <h1 id="hero-heading">
        Gõ là <em>Fun,</em>
        <br />
        Input là chuẩn
      </h1>
      <p class="intro">
        Gõ vui theo cách của bạn. Tiếng Việt trọn từng dấu.
        <br />
        Telex hay VNI, Funput đồng hành cùng bạn
        <br class="desktop-break" /> từ máy tính đến điện thoại.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#platforms">
          Tải Funput miễn phí <span>↗</span>
        </a>
        <a class="text-link" href="#experience">
          Chơi với dấu <span>↓</span>
        </a>
      </div>
      <div class="hero-note">
        <span>Telex & VNI</span>
        <i></i>
        <span>Xử lý nhập liệu trên thiết bị</span>
        <i></i>
        <span>100% miễn phí</span>
      </div>
      <a class="store-news" href={links.WINDOWS_STORE_URL}>
        <span>MỚI</span> Funput đã có trên Microsoft Store <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="key-art" aria-label="Phím chữ ấ và những dấu tiếng Việt">
      <div class="art-orbit orbit-one"></div>
      <div class="art-orbit orbit-two"></div>
      <span class="art-coordinate">VI / 01</span>
      <div class="floating-key key-small key-tilde" aria-hidden="true">
        ~
      </div>
      <div class="floating-key key-small key-circumflex" aria-hidden="true">
        ^
      </div>
      <div class="floating-key key-main" aria-hidden="true">
        <span class="key-corner">funput</span>
        <span class="key-letter">ấ</span>
        <span class="key-bottom">GÕ VUI. CHUẨN TIẾNG VIỆT.</span>
      </div>
      <div class="floating-key key-small key-acute" aria-hidden="true">
        ´
      </div>
      <div class="art-sticker">
        <span>made for</span>
        <strong>tiếng Việt</strong>
        <span>♥</span>
      </div>
      <p class="art-caption">
        <span>↖</span> Vui từng phím. Chuẩn từng dấu.
      </p>
    </div>
    <div class="hero-bottom">
      <span>THÊM VUI KHI GÕ. TRỌN VẸN TỪNG CHỮ.</span>
      <a href="#experience">
        CUỘN ĐỂ KHÁM PHÁ <span>↓</span>
      </a>
    </div>
  </section>

  <div class="platform-ribbon" aria-label="Hỗ trợ năm hệ điều hành">
    <div class="wrap">
      <span>
        MỘT BỘ GÕ.
        <br />
        <strong>MỌI NƠI BẠN ĐẾN.</strong>
      </span>
      {PLATFORMS.map((platform) => (
        <a href={`/${platform.id}/`}>
          <img src={platform.iconSrc} alt="" width="22" height="22" />
          {platform.name}
        </a>
      ))}
    </div>
  </div>

  <section class="playground wrap section-space" id="experience" aria-labelledby="play-title">
    <div class="section-heading">
      <p class="eyebrow">01 / NHỎ MÀ CÓ VÕ</p>
      <div>
        <h2 id="play-title">
          Một dấu nhỏ.
          <br />
          <span>Một nghĩa khác.</span>
        </h2>
        <p>
          Tiếng Việt đẹp từ những điều rất nhỏ.
          <br />
          Chạm vào một dấu, xem điều gì xảy ra.
        </p>
      </div>
    </div>
    <div class="accent-playground">
      <div class="letter-display" aria-hidden="true">
        <span data-big-letter>a</span>
        <span class="letter-label">CHỮ QUEN. CẢM HỨNG MỚI.</span>
      </div>
      <div class="accent-controls">
        <p class="mini-label">THỬ THÊM MỘT CHÚT CÁ TÍNH</p>
        <div class="accent-buttons" role="group" aria-label="Chọn dấu tiếng Việt">
          {accents.map((accent, index) => (
            <button
              type="button"
              data-accent={accent.letter}
              data-word={accent.word}
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-label={`Dấu ${accent.name.toLowerCase()}`}
            >
              <span aria-hidden="true">{accent.mark}</span>
              <small>{accent.name}</small>
            </button>
          ))}
        </div>
        <p class="word-result" aria-live="polite" aria-atomic="true">
          ma <span>→</span> <strong data-word-result>ma</strong>
        </p>
        <p class="play-note">
          Sáu thanh điệu. Vô vàn điều muốn nói.
          <br />
          Funput đồng hành cùng từng phím gõ của bạn.
        </p>
        <p class="demo-note">Minh họa dấu tiếng Việt · không phải bộ gõ trực tuyến</p>
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="wrap manifesto-grid">
      <div>
        <p class="eyebrow">02 / CỨ GÕ. CỨ LÀ BẠN.</p>
        <h2>
          Ý tưởng của bạn.
          <br />
          Tiếng nói của bạn.
          <br />
          <em>Dữ liệu cũng vậy.</em>
        </h2>
        <a class="text-link" href={links.GITHUB_URL}>
          Khám phá mã nguồn <span>↗</span>
        </a>
      </div>
      <div class="principles">
        <article>
          <span>01</span>
          <div>
            <h3>Riêng tư là mặc định.</h3>
            <p>Nhập liệu được xử lý trên thiết bị. Những gì bạn gõ thuộc về bạn.</p>
          </div>
          <span aria-hidden="true">↗</span>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Quen tay, ngay từ đầu.</h3>
            <p>
              Telex hay VNI, chọn cách bạn vẫn gõ. Giữ nguyên thói quen, tiếp tục dòng suy nghĩ.
            </p>
          </div>
          <span aria-hidden="true">↗</span>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>Mở mã nguồn. Mở khả năng.</h3>
            <p>Tự do tìm hiểu, kiểm tra và đóng góp. Một bộ gõ được xây dựng cùng cộng đồng.</p>
          </div>
          <span aria-hidden="true">↗</span>
        </article>
      </div>
    </div>
  </section>

  <section class="downloads wrap section-space" id="platforms" aria-labelledby="platform-title">
    <div class="section-heading">
      <p class="eyebrow">03 / MANG FUNPUT THEO BẠN</p>
      <div>
        <h2 id="platform-title">
          Máy tính hay điện thoại,
          <br />
          <span>đều có Funput.</span>
        </h2>
        <p>
          Một cảm giác gõ quen thuộc.
          <br />
          Từ bàn làm việc đến lòng bàn tay.
        </p>
      </div>
    </div>
    <div class="store-grid">
      {stores.map((store) => {
        const platform = PLATFORMS.find((p) => p.id === store.id)!;
        return (
          <article class:list={['store-card', store.id]}>
            <div class="store-card-top">
              <span>{store.storeName}</span>
              <span class="store-status">{store.badge}</span>
            </div>
            <div class="store-art" aria-hidden="true">
              <div class="store-art-top">
                <img src="/brand/logo.png" width="44" height="44" alt="" loading="lazy" />
                <img src={platform.iconSrc} width="24" height="24" alt="" />
              </div>
              <span>
                {store.word}
                <span class="typing-cursor">|</span>
              </span>
              <small>GÕ VUI. CHUẨN TIẾNG VIỆT.</small>
            </div>
            <h3>{store.name}</h3>
            <p class="store-description">{store.description}</p>
            <div class="store-actions">
              <StoreDownloadButton platform={store.id} compact />
              <a href={`/${store.id}/`}>
                Khám phá bản {store.name} <span aria-hidden="true">→</span>
              </a>
            </div>
            <small class="store-requirements">{store.requirements} · Miễn phí</small>
          </article>
        );
      })}
    </div>
    <p class="other-platforms">
      Cũng có trên máy tính bạn yêu thích <span aria-hidden="true">↘</span>
    </p>
    <div class="download-grid">
      {PLATFORMS.filter((platform) => platform.id === 'macos' || platform.id === 'linux').map(
        (platform) => (
          <article class="download-card">
            <div class="card-top">
              <img src={platform.iconSrc} alt="" width="32" height="32" />
              <span>{platform.id === 'macos' ? 'MAC' : 'LINUX'}</span>
            </div>
            <h3>{platform.name}</h3>
            <p>{platform.blurb}</p>
            <a href={platform.ctaHref}>
              {platform.id === 'linux' ? 'Hướng dẫn cài' : 'Xem bản tải trên GitHub'}
              <span aria-hidden="true">↗</span>
              <span class="sr-only"> cho {platform.name}</span>
            </a>
            <a class="platform-details" href={`/${platform.id}/`}>
              Tìm hiểu Funput cho {platform.name} <span aria-hidden="true">→</span>
            </a>
            <small>{platform.bullets[0]}</small>
          </article>
        ),
      )}
    </div>
  </section>

  <section class="getting-started wrap section-space" aria-labelledby="getting-started-title">
    <div class="product-intro">
      <div>
        <p class="eyebrow">04 / BẮT ĐẦU VỚI FUNPUT</p>
        <h2 id="getting-started-title">
          Quen từ cách gõ.
          <br />
          <span>Rõ từng lựa chọn.</span>
        </h2>
        <p>
          Chọn Telex, Telex nâng cao hoặc VNI trong giao diện dành riêng cho thiết bị của bạn. Xem
          hướng dẫn để cài đặt và gõ câu tiếng Việt đầu tiên.
        </p>
        <a href="/blog/funput-la-gi/">
          Tìm hiểu Funput <span aria-hidden="true">→</span>
        </a>
      </div>
      <figure>
        <img
          src="/brand/screenshots/windows.png"
          width="960"
          height="756"
          alt="Cài đặt Funput trên Windows với các lựa chọn Telex, Telex+ và VNI"
          loading="lazy"
        />
        <figcaption>Giao diện Funput trên Windows</figcaption>
      </figure>
    </div>
    <div class="starter-guides">
      <a href="/blog/telex-vni-va-telex-nang-cao/">
        <span>CHỌN KIỂU GÕ</span>
        <h3>Telex, VNI hay Telex nâng cao?</h3>
        <p>Bảng phím và ví dụ để chọn cách gõ hợp tay.</p>
        <span class="guide-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <a href="/blog/cach-bat-ban-phim-funput-iphone-ipad/">
        <span>IPHONE & IPAD</span>
        <h3>Bật bàn phím Funput</h3>
        <p>Từng bước thêm bàn phím, cấp quyền và bắt đầu gõ.</p>
        <span class="guide-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <a href="/blog/cai-funput-windows-10-11/">
        <span>WINDOWS 10 & 11</span>
        <h3>Cài Funput trên Windows</h3>
        <p>Cài từ Microsoft Store, chọn kiểu gõ và bắt đầu gõ tiếng Việt.</p>
        <span class="guide-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    </div>
  </section>
  <section class="closing">
    <div class="wrap">
      <p class="eyebrow">THÊM DẤU CHO CHỮ. THÊM VUI CHO NGÀY.</p>
      <h2>
        Gõ điều <span>bạn muốn.</span>
        <span class="closing-star" aria-hidden="true">
          ✳
        </span>
      </h2>
      <div>
        <p>Bắt đầu bằng một lời chào. Xin chào, Funput.</p>
        <a class="button" href="#platforms">
          Cùng gõ thôi <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-accent]');
  const letter = document.querySelector<HTMLElement>('[data-big-letter]');
  const word = document.querySelector<HTMLElement>('[data-word-result]');
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      if (letter) letter.textContent = button.dataset.accent ?? 'a';
      if (word) word.textContent = button.dataset.word ?? 'ma';
    }),
  );
</script>

<style>
  .store-news {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
    font-size: 12px;
    line-height: 1.8;
  }
  .store-news > span:first-child {
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--sage);
    color: #4a5a31;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
  }
  .store-news:hover {
    color: #ba3919;
  }
  .store-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .store-card {
    --store-tint: #e8eddb;
    --store-border: #d5dec4;
    --store-accent: #4a5a31;
    min-width: 0;
    padding: 24px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--store-border);
    border-radius: 16px;
    background: linear-gradient(145deg, var(--store-tint), var(--paper));
  }
  .store-card.ios {
    --store-tint: #f5e6df;
    --store-border: #e9d4c9;
    --store-accent: #8b4c36;
  }
  .store-card.android {
    --store-tint: #e2ebf1;
    --store-border: #cedde6;
    --store-accent: #3d6178;
  }
  .store-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
  }
  .store-status {
    color: var(--store-accent);
    background: #ffffff80;
    border-radius: 4px;
    padding: 5px 7px;
    font-size: 8px;
    letter-spacing: 0.5px;
  }
  .store-art {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    margin-block: 24px 28px;
    border: 1px solid #ffffff;
    border-radius: 12px;
    background: #ffffff80;
    box-shadow: 0 10px 24px #34412b0a;
  }
  .store-art-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .store-art-top img {
    object-fit: contain;
  }
  .store-art-top img:last-child {
    opacity: 0.5;
  }
  .store-art > span {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -1.2px;
    white-space: nowrap;
  }
  .typing-cursor {
    color: var(--orange);
    margin-left: 4px;
    font-weight: 400;
  }
  .store-art small {
    font-size: 8px;
    letter-spacing: 1px;
    color: var(--muted);
  }
  .store-card h3 {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.8px;
    line-height: 1.4;
  }
  .store-description {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    margin-block: 12px 24px;
    flex: 1;
  }
  .store-actions {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .store-actions > a {
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 32px;
  }
  .store-actions > a:hover {
    color: #ba3919;
  }
  .store-requirements {
    border-top: 1px solid var(--store-border);
    padding-top: 16px;
    margin-top: 16px;
    font-size: 10px;
    color: var(--muted);
    line-height: 1.8;
  }
  .other-platforms {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block: 32px 18px;
    color: var(--muted);
    font-size: 13px;
  }
  .other-platforms span {
    color: var(--orange);
    font-size: 20px;
  }
  @media (max-width: 1050px) and (min-width: 901px) {
    .store-card {
      padding: 18px;
    }
    .store-card-top {
      flex-wrap: wrap;
    }
    .store-art {
      padding: 16px;
    }
    .store-art > span {
      font-size: 28px;
    }
  }
  @media (max-width: 900px) {
    .store-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .store-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 28px;
    }
    .store-card-top {
      grid-column: 1 / -1;
      margin-bottom: 24px;
    }
    .store-art {
      grid-column: 1;
      grid-row: 2 / 6;
      margin: 0;
      justify-content: center;
    }
    .store-card h3,
    .store-description,
    .store-actions,
    .store-requirements {
      grid-column: 2;
    }
  }
  @media (max-width: 600px) {
    .store-card {
      display: flex;
      padding: 24px;
    }
    .store-card-top {
      margin-bottom: 0;
    }
    .store-art {
      margin-block: 24px;
    }
    .store-art > span {
      font-size: 32px;
    }
  }
  @media (max-width: 370px) {
    .store-card {
      padding: 18px;
    }
    .store-art {
      padding: 16px;
    }
    .store-art > span {
      font-size: 28px;
    }
  }
  .getting-started {
    border-top: 1px solid var(--line);
  }
  .product-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .product-intro h2 {
    margin-top: 24px;
    font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 600;
    letter-spacing: -1.5px;
    line-height: 1.25;
  }
  .product-intro h2 span {
    color: var(--muted);
  }
  .product-intro p:not(.eyebrow) {
    font-size: 16px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 24px;
  }
  .product-intro a {
    display: inline-flex;
    gap: 20px;
    padding-block: 15px;
    margin-top: 12px;
    color: #ba3919;
    font-size: 15px;
  }
  .product-intro figure {
    padding: 24px;
    border-radius: 16px;
    background: var(--sage);
  }
  .product-intro img {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .product-intro figcaption {
    text-align: center;
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }
  .starter-guides {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .starter-guides > a {
    display: flex;
    flex-direction: column;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .starter-guides > a:hover {
    border-color: var(--orange);
  }
  .starter-guides span {
    font-size: 11px;
    letter-spacing: 1px;
