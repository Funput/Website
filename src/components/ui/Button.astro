---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  external?: boolean;
}

const { href, variant = 'primary', class: className = '', external = false } = Astro.props;

const variants = {
  primary:
    'bg-brand-orange-500 text-white hover:bg-brand-orange-600 focus-visible:outline-brand-orange-500',
  secondary:
    'border border-brand-dark-700 bg-brand-dark-900 text-zinc-200 hover:border-brand-dark-600 hover:bg-brand-dark-800 hover:text-white',
  ghost:
    'border border-brand-dark-700 bg-brand-dark-950 text-white hover:border-brand-orange-500 hover:bg-brand-dark-900',
};

const base =
  'inline-flex items-center justify-center rounded-xl px-6 py-3 text-sm font-semibold transition-colors duration-200';
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>
