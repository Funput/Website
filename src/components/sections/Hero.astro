---
import { FUNPUT_CONSTANTS } from '../../lib/constants';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(249,115,22,0.12),_transparent_55%)]"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-20 sm:px-6 lg:px-8 lg:pt-24 lg:pb-28">
    <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="text-center lg:col-span-6 lg:text-left">
        <img
          src="/brand/wordmark-gradient.png"
          width="640"
          height="213"
          alt="Funput"
          class="motion-fade-up mx-auto h-10 w-auto sm:h-12 lg:mx-0 lg:h-14"
        />

        <h1 class="motion-fade-up-delay mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl lg:leading-tight">
          Gõ là <span class="text-brand-orange-500">Fun</span>,<br />
          Input là chuẩn.
        </h1>

        <p class="motion-fade-up-delay-2 mx-auto mt-6 max-w-xl text-lg leading-relaxed text-zinc-400 lg:mx-0">
          Bộ gõ tiếng Việt mã nguồn mở — nhẹ, an toàn, thiết kế riêng cho từng hệ điều hành. Gõ
          Telex hoặc VNI trên máy Mac, Windows, Linux, iPhone, iPad và Android.
        </p>

        <div class="motion-fade-up-delay-2 mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row lg:justify-start">
          <Button href={FUNPUT_CONSTANTS.RELEASES_URL} external class="w-full px-8 py-4 sm:w-auto">
            Tải bản mới nhất
          </Button>
          <Button
            href={FUNPUT_CONSTANTS.INSTALL_DOCS_URL}
            variant="secondary"
            external
            class="w-full px-8 py-4 sm:w-auto"
          >
            Hướng dẫn cài đặt
          </Button>
        </div>
      </div>

      <div class="motion-fade-in relative lg:col-span-6">
        <div
          class="motion-ambient pointer-events-none absolute inset-[12%] rounded-full bg-brand-orange-500/20 blur-3xl"
          aria-hidden="true"
        ></div>
        <img
          src="/brand/logo.png"
          width="512"
          height="512"
          alt="Logo Funput"
          class="relative mx-auto h-auto w-full max-w-sm lg:max-w-md"
        />
      </div>
    </div>
  </div>
</section>
