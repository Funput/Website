---
import { PLATFORMS } from '../../lib/platforms';
import Button from '../ui/Button.astro';
---

<section
  id="platforms"
  class="border-t border-brand-dark-800/60 bg-brand-dark-900/30 py-20 lg:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center lg:mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Một bộ gõ, mọi thiết bị
      </h2>
      <p class="mt-4 text-lg text-zinc-400">
        Gõ Telex hoặc VNI trên iOS, Android, macOS, Windows và Linux — mỗi hệ một trải nghiệm riêng.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {PLATFORMS.map((platform) => (
        <article class="group relative flex flex-col justify-between rounded-2xl border border-brand-dark-800 bg-brand-dark-900/50 p-7 transition-colors duration-200 hover:border-brand-orange-500/35 lg:p-8">
          <div>
            <div class="mb-6 flex items-center justify-between">
              <div class="rounded-xl bg-brand-dark-950 p-3">
                <img
                  src={platform.iconSrc}
                  alt={platform.iconAlt}
                  width="32"
                  height="32"
                  class="h-8 w-8 invert opacity-80 transition-opacity group-hover:opacity-100"
                />
              </div>
              <span class="inline-flex items-center rounded-md border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-400">
                {platform.badge}
              </span>
            </div>

            <h3 class="mb-3 text-xl font-bold text-white">{platform.name}</h3>
            <p class="mb-6 text-sm leading-relaxed text-zinc-400">{platform.blurb}</p>

            <ul class="mb-6 space-y-3 text-sm text-zinc-500">
              {platform.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <svg
                    class="mt-0.5 h-5 w-5 shrink-0 text-brand-orange-500"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <div
              class:list={[
                'mb-8 overflow-hidden rounded-xl border border-brand-dark-700 bg-brand-dark-950',
                platform.phoneFrame && 'mx-auto max-w-[11rem] rounded-2xl',
              ]}
            >
              <img
                src={platform.screenshotSrc}
                width={platform.screenshotWidth}
                height={platform.screenshotHeight}
                alt={platform.screenshotAlt}
                loading="lazy"
                decoding="async"
                class="h-auto w-full"
              />
            </div>
          </div>

          <Button href={platform.ctaHref} variant="ghost" external class="w-full">
            {platform.ctaLabel}
          </Button>
        </article>
      ))}
    </div>
  </div>
</section>
