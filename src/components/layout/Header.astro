---
import { FUNPUT_CONSTANTS } from '../../lib/constants';
import { PRIMARY_NAV } from '../../lib/nav';
import Button from '../ui/Button.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-brand-dark-800/80 bg-brand-dark-950/85 backdrop-blur-md">
  <div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="relative z-10 flex shrink-0 items-center" aria-label="Funput — Trang chủ">
      <img
        src="/brand/lockup-gradient.png"
        width="480"
        height="160"
        alt="Funput"
        class="h-8 w-auto sm:h-9"
      />
    </a>

    <nav
      class="absolute top-1/2 left-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-8 md:flex"
      aria-label="Điều hướng chính"
    >
      {PRIMARY_NAV.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-zinc-400 transition-colors hover:text-white"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="relative z-10 flex items-center gap-3">
      <Button href={FUNPUT_CONSTANTS.RELEASES_URL} external class="hidden px-5 py-2 sm:inline-flex">
        Tải xuống
      </Button>

      <details class="group relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-brand-dark-700 text-zinc-300 hover:border-brand-dark-600 hover:text-white [&::-webkit-details-marker]:hidden"
          aria-label="Mở menu"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="absolute right-0 mt-3 w-56 rounded-xl border border-brand-dark-800 bg-brand-dark-900 p-3 shadow-xl shadow-black/40">
          <nav class="flex flex-col gap-1" aria-label="Menu di động">
            {PRIMARY_NAV.map((link) => (
              <a
                href={link.href}
                class="rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-300 hover:bg-brand-dark-800 hover:text-white"
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))}
            <a
              href={FUNPUT_CONSTANTS.RELEASES_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 rounded-lg bg-brand-orange-500 px-3 py-2.5 text-center text-sm font-semibold text-white hover:bg-brand-orange-600"
            >
              Tải xuống
            </a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
