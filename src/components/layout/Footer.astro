---
import { FUNPUT_CONSTANTS as links } from '../../lib/constants';
---

<footer class="site-footer site-wrap">
  <div class="footer-main">
    <div class="footer-intro">
      <a class="site-brand" href="/" aria-label="Funput — Trang chủ">
        <img src="/brand/horizontal-lockup-gradient.png" width="2172" height="724" alt="Funput" />
      </a>
      <p>
        Được làm với tình yêu
        <br />
        dành cho tiếng Việt.
      </p>
      <span class="footer-signoff">Gõ vui nhé :)</span>
    </div>
    <nav aria-label="Liên kết cuối trang">
      <div class="footer-group">
        <h2>Tải Funput</h2>
        <ul>
          <li>
            <a href="/macos/">macOS</a>
          </li>
          <li>
            <a href="/windows/">Windows</a>
          </li>
          <li>
            <a href="/linux/">Linux</a>
          </li>
          <li>
            <a href="/ios/">iPhone & iPad</a>
          </li>
          <li>
            <a href="/android/">Android</a>
          </li>
        </ul>
      </div>
      <div class="footer-group">
        <h2>Khám phá</h2>
        <ul>
          <li>
            <a href="/blog/">Blog</a>
          </li>
          <li>
            <a href={links.DOCS_URL}>
              Hướng dẫn <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href={links.GITHUB_URL}>
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href="/privacy/">Quyền riêng tư</a>
          </li>
          <li>
            <a href={`mailto:${links.CONTACT_EMAIL}`}>Liên hệ</a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Funput</span>
    <a href={links.LICENSE_URL}>Tự do & mã nguồn mở · MIT License</a>
  </div>
</footer>
<style>
  .site-footer {
    padding-top: 56px;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding-bottom: 40px;
  }
  .footer-intro p {
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .footer-signoff {
    display: block;
    margin-top: 20px;
    font-size: 13px;
    color: #ba3919;
  }
  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .footer-group h2 {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
  }
  .footer-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-group a {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    min-height: 44px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .footer-group a span {
    font-size: 12px;
  }
  a:hover {
    color: #ba3919;
  }
  a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 4px;
    border-radius: 3px;
  }
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .site-footer {
      padding-top: 38px;
    }
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-bottom: 28px;
    }
    .footer-intro p {
      margin-top: 12px;
    }
    .footer-signoff {
      margin-top: 12px;
    }
    nav {
      border-top: 1px solid var(--line);
      padding-top: 24px;
      gap: 20px;
    }
    .footer-group h2 {
      margin-bottom: 8px;
    }
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
      padding-block: 20px;
    }
  }
</style>
