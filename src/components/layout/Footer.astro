---
import { FUNPUT_CONSTANTS as links } from '../../lib/constants';
---

<footer class="site-footer site-wrap">
  <div class="footer-main">
    <div class="footer-intro">
      <a class="site-brand" href="/" aria-label="Funput: Trang chủ">
        <img src="/brand/horizontal-lockup-gradient.png" width="2172" height="724" alt="Funput" />
      </a>
      <p>Bộ gõ tiếng Việt mã nguồn mở.</p>
    </div>
    <nav class="footer-menu" aria-label="Liên kết cuối trang">
      <div class="footer-group footer-downloads">
        <h2>Tải Funput</h2>
        <ul role="list">
          <li>
            <a href="/macos/">macOS</a>
          </li>
          <li>
            <a href="/windows/">Windows</a>
          </li>
          <li>
            <a href="/linux/">Linux</a>
          </li>
          <li>
            <a href="/ios/">iPhone & iPad</a>
          </li>
          <li>
            <a href="/android/">Android</a>
          </li>
        </ul>
      </div>
      <div class="footer-group">
        <h2>Tài nguyên</h2>
        <ul role="list">
          <li>
            <a href={links.DOCS_URL}>
              <span>
                Tài liệu&nbsp;
                <span class="footer-external-mark" aria-hidden="true">
                  ↗
                </span>
              </span>
            </a>
          </li>
          <li>
            <a href="/blog/">Blog</a>
          </li>
        </ul>
      </div>
      <div class="footer-group">
        <h2>Dự án</h2>
        <ul role="list">
          <li>
            <a href={links.GITHUB_URL}>
              <span>
                Mã nguồn trên GitHub&nbsp;
                <span class="footer-external-mark" aria-hidden="true">
                  ↗
                </span>
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${links.CONTACT_EMAIL}`}>Liên hệ</a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Funput</span>
    <nav aria-label="Thông tin pháp lý">
      <ul class="footer-legal" role="list">
        <li>
          <a href="/privacy/">Quyền riêng tư</a>
        </li>
        <li>
          <a href={links.LICENSE_URL}>Giấy phép MIT</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
<style>
  .site-footer {
    padding-top: 56px;
  }
  .footer-main {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(0, 2fr);
    align-items: start;
    gap: clamp(40px, 5vw, 72px);
    padding-bottom: 32px;
  }
  .footer-intro p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
  }
  .footer-menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 1.25fr);
    gap: clamp(20px, 3vw, 40px);
    padding-top: 8px;
  }
  .footer-group h2 {
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-group a {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 32px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .footer-external-mark {
    font-size: 12px;
  }
  a:hover {
    color: #ba3919;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 4px;
    border-radius: 3px;
  }
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  .footer-legal a {
    display: flex;
    align-items: center;
    min-height: 32px;
  }
  @media (max-width: 820px) {
    .site-footer {
      padding-top: 38px;
    }
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      padding-bottom: 24px;
    }
    .footer-menu {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 20px;
      padding-top: 0;
    }
    .footer-downloads {
      grid-column: 1 / -1;
    }
    .footer-downloads ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      column-gap: 20px;
    }
    .footer-group a,
    .footer-legal a {
      min-height: 44px;
    }
  }
  @media (max-width: 480px) {
    .footer-bottom {
      flex-direction: column-reverse;
      align-items: start;
      gap: 0;
      padding-block: 8px 20px;
    }
  }
</style>
