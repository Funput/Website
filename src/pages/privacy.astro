---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { Content, frontmatter } from '../content/privacy.md';
---

<BaseLayout
  title={`${frontmatter.title} | Funput`}
  description={frontmatter.description}
  canonicalPath="/privacy"
>
  <Header slot="header" />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <header class="mb-12">
      <p class="text-sm font-medium text-brand-orange-500">Pháp lý</p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {frontmatter.title}
      </h1>
      <p class="mt-4 text-sm text-zinc-500">Cập nhật lần cuối: {frontmatter.lastUpdated}</p>
    </header>

    <div class="prose prose-invert prose-zinc max-w-none prose-headings:scroll-mt-24 prose-headings:tracking-tight prose-a:text-zinc-300 prose-a:underline-offset-2 hover:prose-a:text-white prose-li:marker:text-zinc-600">
      <Content />
    </div>

    <footer class="mt-14 border-t border-brand-dark-800 pt-8">
      <a href="/" class="text-sm font-medium text-zinc-400 transition-colors hover:text-white">
        ← Về trang chủ
      </a>
    </footer>
  </article>
  <Footer slot="footer" />
</BaseLayout>
