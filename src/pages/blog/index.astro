---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FUNPUT_CONSTANTS as links } from '../../lib/constants';
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = (date: Date) =>
  date.toLocaleDateString('vi-VN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout
  title="Blog | Funput"
  description="Những câu chuyện, cập nhật và hướng dẫn từ Funput — bộ gõ tiếng Việt mã nguồn mở."
  canonicalPath="/blog"
>
  <div class="site-wrap">
    <header class="blog-hero">
      <div>
        <p class="page-eyebrow">GHI CHÉP TỪ FUNPUT</p>
        <h1 class="page-title">
          Sau mỗi
          <br /> <em>phím gõ.</em>
        </h1>
        <p class="page-lead">
          Những điều đang làm. Những điều học được.
          <br />
          Và những câu chuyện trên hành trình xây dựng Funput.
        </p>
      </div>
      <div class="journal-art" aria-hidden="true">
        <span class="paper-back"></span>
        <div class="paper-front">
          <span>FUNPUT JOURNAL</span>
          <strong>
            Chuyện
            <br />
            con chữ<span>.</span>
          </strong>
          <div class="paper-lines"></div>
          <small>GHI LẠI ĐỂ CÙNG ĐI XA HƠN ↗</small>
        </div>
        <span class="asterisk">✳</span>
      </div>
    </header>
    <section class="posts-section" aria-labelledby="posts-title">
      <div class="section-label">
        <h2 id="posts-title">Bài viết mới nhất</h2>
        <span>{String(posts.length).padStart(2, '0')} BÀI VIẾT</span>
      </div>
      {posts.length === 0 ? (
        <div class="empty-journal">
          <div class="empty-mark" aria-hidden="true">
            …
          </div>
          <div>
            <p class="page-eyebrow">TRANG MỚI ĐANG ĐƯỢC VIẾT</p>
            <h3>Câu chuyện sắp bắt đầu.</h3>
            <p>
              Chưa có bài viết được xuất bản. Trong lúc chờ, bạn có thể xem những cập nhật mới nhất
              của Funput trên GitHub.
            </p>
            <a href={links.RELEASES_URL}>
              Xem cập nhật trên GitHub <span>↗</span>
            </a>
          </div>
        </div>
      ) : (
        <ol class="post-list">
          {posts.map((post, index) => (
            <li>
              <article class:list={['post-entry', { featured: index === 0 }]}>
                <div class="post-number">
                  {String(index + 1).padStart(2, '0')}
                  <span>{index === 0 ? 'MỚI NHẤT' : 'GHI CHÉP'}</span>
                </div>
                <div>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <h3>
                    <a href={`/blog/${post.id}/`}>
                      {post.data.title}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p>{post.data.description}</p>
                  <div class="post-tags">
                    {post.data.tags.map((tag) => (
                      <span>#{tag}</span>
                    ))}
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ol>
      )}
    </section>
    <aside class="community-note">
      <div>
        <p class="page-eyebrow">ĐƯỢC XÂY DỰNG CÙNG NHAU</p>
        <h2>Mỗi góp ý đều có ý nghĩa.</h2>
        <p>Một ý tưởng, một lỗi nhỏ, hay chỉ một lời chào — chúng tôi luôn muốn nghe.</p>
      </div>
      <a class="site-button" href={links.GITHUB_URL}>
        Gặp nhau trên GitHub <span>↗</span>
      </a>
    </aside>
  </div>
</BaseLayout>
<style>
  .blog-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 50px;
    align-items: center;
    padding-block: 72px 80px;
  }
  .page-title {
    margin-top: 29px;
  }
  .page-lead {
    margin-top: 26px;
    font-size: 14px;
  }
  .journal-art {
    position: relative;
    width: 330px;
    height: 320px;
    margin: auto;
  }
  .paper-back {
    position: absolute;
    inset: 10px 10px 0;
    border: 1px solid #bec7ae;
    border-radius: 4px;
    background: var(--sage);
    transform: rotate(11deg);
  }
  .paper-front {
    position: absolute;
    inset: 0 16px 10px 0;
    padding: 28px;
    background: #fffcf4;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 15px 30px #24251f0d;
    transform: rotate(-7deg);
  }
  .paper-front > span {
    font-size: 9px;
    letter-spacing: 2px;
  }
  .paper-front strong {
    display: block;
    font-size: 42px;
    letter-spacing: -2px;
    line-height: 1.25;
    font-weight: 600;
    margin-top: 28px;
  }
  .paper-front strong span {
    color: var(--orange);
  }
  .paper-lines {
    height: 34px;
    margin-top: 22px;
    background: repeating-linear-gradient(transparent 0 10px, var(--line) 10px 11px);
  }
  .paper-front small {
    display: block;
    margin-top: 19px;
    font-size: 7px;
    letter-spacing: 1px;
  }
  .asterisk {
    position: absolute;
    right: -17px;
    top: 20px;
    font-size: 95px;
    color: var(--orange);
    line-height: 1;
    transform: rotate(15deg);
  }
  .posts-section {
    border-top: 1px solid var(--line);
    padding-block: 26px 60px;
  }
  .section-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .section-label h2 {
    font-size: 13px;
    font-weight: 500;
  }
  .section-label > span {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 1.5px;
  }
  .empty-journal {
    display: grid;
    grid-template-columns: 180px 1fr;
    align-items: center;
    gap: 50px;
    padding: 54px;
    margin-top: 30px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .empty-mark {
    display: grid;
    place-items: center;
    width: 155px;
    height: 155px;
    background: var(--sage);
    color: #4b593c;
    border-radius: 24px;
    font-size: 90px;
    line-height: 1;
    padding-bottom: 40px;
    transform: rotate(-7deg);
    box-shadow: 0 8px 0 #d6ddc7;
  }
  .empty-journal h3 {
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -1px;
    margin-top: 16px;
  }
  .empty-journal p:not(.page-eyebrow) {
    max-width: 580px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
    margin-top: 15px;
  }
  .empty-journal a {
    display: inline-flex;
    gap: 20px;
    margin-top: 25px;
    color: #ba3919;
    font-size: 12px;
  }
  .post-list {
    margin-top: 30px;
  }
  .post-entry {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 45px;
    padding: 38px 28px;
    border-bottom: 1px solid var(--line);
  }
  .post-entry.featured {
    background: var(--sage);
    border-radius: 10px;
    border: 0;
  }
  .post-number {
    font-size: 48px;
    color: #849174;
    letter-spacing: -2px;
  }
  .post-number span {
    display: block;
    font-size: 8px;
    letter-spacing: 1.5px;
    margin-top: 12px;
  }
  .post-entry time {
    font-size: 11px;
    color: var(--muted);
  }
  .post-entry h3 {
    font-size: 30px;
    letter-spacing: -1px;
    font-weight: 600;
    line-height: 1.4;
    margin-top: 14px;
    overflow-wrap: anywhere;
  }
  .post-entry h3 a {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .post-entry h3 a:hover {
    color: #ba3919;
  }
  .post-entry h3 span {
    color: var(--orange);
  }
  .post-entry p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.9;
    margin-top: 16px;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 10px;
    color: var(--muted);
    margin-top: 20px;
  }
  .community-note {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    background: #262a23;
    color: var(--paper);
    border-radius: 12px;
    padding: 42px;
    margin-bottom: 35px;
  }
  .community-note .page-eyebrow {
    color: #d5e6b1;
  }
  .community-note h2 {
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.8px;
    margin-top: 18px;
  }
  .community-note p:not(.page-eyebrow) {
    font-size: 12px;
    line-height: 1.9;
    color: #b8bcae;
    margin-top: 12px;
    max-width: 550px;
  }
  .community-note .site-button {
    flex-shrink: 0;
    background: #d5e6b1;
    color: var(--ink);
  }
  @media (max-width: 1050px) {
    .journal-art {
      transform: scale(0.85);
    }
    .blog-hero {
      gap: 20px;
    }
    .community-note {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (max-width: 760px) {
    .blog-hero {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 45px 55px;
      gap: 38px;
    }
    .journal-art {
      transform: scale(0.85);
      height: 300px;
      width: 290px;
      max-width: calc(100% - 20px);
    }
    .page-lead {
      font-size: 13px;
    }
    .empty-journal {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 28px 23px;
    }
    .empty-mark {
      width: 85px;
      height: 85px;
      font-size: 50px;
      padding-bottom: 25px;
      border-radius: 15px;
    }
    .empty-journal h3 {
      font-size: 26px;
    }
    .empty-journal .page-eyebrow {
      font-size: 8px;
    }
    .community-note {
      padding: 28px 24px;
    }
    .community-note h2 {
      font-size: 25px;
    }
    .post-entry {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 22px;
      gap: 20px;
    }
    .post-number {
      font-size: 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .post-number span {
      margin-top: 0;
    }
    .post-entry h3 {
      font-size: 25px;
    }
  }
</style>
