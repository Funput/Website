---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog | Funput"
  description="Tin tức và cập nhật từ Funput — bộ gõ tiếng Việt mã nguồn mở."
  canonicalPath="/blog"
>
  <Header slot="header" />
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <header class="mb-12">
      <p class="text-sm font-medium text-brand-orange-500">Cập nhật</p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Blog</h1>
      <p class="mt-4 text-lg text-zinc-400">Tin tức, changelog và hướng dẫn từ đội ngũ Funput.</p>
    </header>

    {posts.length === 0 ? (
      <p class="rounded-2xl border border-brand-dark-800 bg-brand-dark-900/40 px-6 py-10 text-zinc-400">
        Chưa có bài viết công khai. Sắp có tin tức từ Funput.
      </p>
    ) : (
      <ul class="space-y-6">
        {posts.map((post) => (
          <li class="rounded-2xl border border-brand-dark-800 bg-brand-dark-900/40 p-6 transition-colors hover:border-brand-orange-500/30">
            <a
              class="text-xl font-semibold text-white hover:text-brand-orange-500"
              href={`/blog/${post.id}/`}
            >
              {post.data.title}
            </a>
            <p class="mt-2 text-sm text-zinc-500">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('vi-VN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </p>
            <p class="mt-3 text-zinc-400">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
  <Footer slot="footer" />
</BaseLayout>
