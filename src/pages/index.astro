---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Platforms from '../components/sections/Platforms.astro';
import { DEFAULT_DESCRIPTION, HOME_TITLE, homeJsonLd } from '../lib/seo';
---

<BaseLayout
  title={HOME_TITLE}
  description={DEFAULT_DESCRIPTION}
  canonicalPath="/"
  jsonLd={homeJsonLd()}
>
  <Header slot="header" />
  <Hero />
  <Platforms />
  <Footer slot="footer" />
</BaseLayout>
